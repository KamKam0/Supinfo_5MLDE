# ==============================================================================
# Variables d'Environnement Modèle (.env.example) - Projet Steam 5MLDE
# Copier ce fichier sous le nom .env à la racine et/ou dans infra/ pour surcharger.
# ==============================================================================

# Ports des services d'infrastructure
MLFLOW_PORT=7281
PREFECT_PORT=4200
GRAFANA_PORT=3000
POSTGRES_PORT=5432

# Ports des APIs applicatives
API_INFERENCE_PORT=8001
API_COLLECTOR_PORT=8000

# Base de données PostgreSQL
POSTGRES_DB=steam_api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=5mlde-local-postgres
API_DB_PASSWORD=5mlde-local-api
GRAFANA_DB_PASSWORD=5mlde-local-grafana

# Authentification Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=5mlde-local-admin

# URIs d'accès aux services (pour les SDKs et APIs)
MLFLOW_TRACKING_URI=http://127.0.0.1:7281
MLFLOW_REGISTRY_URI=http://127.0.0.1:7281
PREFECT_API_URL=http://127.0.0.1:4200/api
DATABASE_URL=postgresql://api_writer:5mlde-local-api@127.0.0.1:5432/steam_api
